#. Plugin Name of the plugin
#: langeto.php
msgid "Langeto - Product Tabs for WooCommerce"
msgstr "Langeto - zakładki produktu dla WooCommerce"

#. Plugin URI of the plugin
#: langeto.php
msgid "https://plogins.com/plogins-tabby/"
msgstr "https://plogins.com/plogins-tabby/"

#. Description of the plugin
#: langeto.php
msgid "Add custom tabs with your own content to WooCommerce product pages."
msgstr ""
"Dodawaj własne zakładki z własną treścią do stron produktów WooCommerce."

#. Author of the plugin
#: langeto.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
#: langeto.php
msgid "https://wppoland.com"
msgstr "https://wppoland.com"

#: langeto.php:48
msgid ""
"Langeto - Product Tabs for WooCommerce requires WooCommerce to be active."
msgstr "Langeto - zakładki produktu dla WooCommerce wymaga aktywnego WooCommerce."

